+		let online = true;
+		let got: { manifest: Manifest; etag: string } | null = null;
+		try {
+			if (write) {
+				const r = await this.backend.acquireLease(this.owner, this.opts.leaseMs, this.opts.steal);
+				if (!r.ok) throw new RemoteLeaseError(r.owner, r.until);
