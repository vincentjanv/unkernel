+  "r2_buckets": [{ "binding": "CHUNKS", "bucket_name": "unkernel-disks" }],
+  "durable_objects": { "bindings": [{ "name": "DISK", "class_name": "DiskDO" }] },
+  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiskDO"] }],
+  // Browser origin allowed to call the API ("*" for any; the token still guards it).
+  "vars": { "ALLOWED_ORIGIN": "*" }
