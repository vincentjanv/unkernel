{
  // Disk sync server for the unkernel page: R2 holds the immutable chunks,
  // one Durable Object per disk holds the manifest (compare-and-swap) and the
  // single-writer lease. Same REST protocol as web/scripts/disk-server.ts.
  //
  //   npx wrangler r2 bucket create unkernel-disks
  //   (optional) npx wrangler secret put TOKEN   -- without a token the API is open, see README
  //   npx wrangler deploy
  "name": "unkernel-disks",
  // Only reachable through terminal.verbi.st (behind Access), not on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "r2_buckets": [{ "binding": "CHUNKS", "bucket_name": "unkernel-disks" }],
  // The page itself (npm run deploy:page builds it into web/.output/public).
  // Only /disks/* and /distros/* run the Worker; every other request is a
  // static file. The distro images are in R2 (_distros/), not in the assets.
  "assets": {
    "directory": "../.output/public",
    "run_worker_first": ["/disks/*", "/distros/*"]
  },
  // Served on its own domain (the verbi.st zone must be on this Cloudflare account); workers.dev keeps working.
  "routes": [{ "pattern": "ssh.verbi.st", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "DISK", "class_name": "DiskDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiskDO"] }],
  // Browser origin allowed to call the API ("*" for any; the token still guards it).
  // Cloudflare Access (application "unkernel terminal"): the Worker only answers requests that carry its token.
  "vars": { "ALLOWED_ORIGIN": "*", "ACCESS_TEAM": "doubleleaf.cloudflareaccess.com", "ACCESS_AUD": "7a371d99324d60bbcd481124c421ed86a3ec743c7678f51a488a6c652c2987b5" }
}
